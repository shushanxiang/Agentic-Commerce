# ===== LLM 配置 =====
# LLM 提供商: qwen (百炼 OpenAI 兼容) 或 dashscope (DashScope SDK)
LLM_PROVIDER=qwen

# 千问百炼 API Key (OpenAI 兼容模式 + DashScope 共用同一 Key)
QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=https://your-bailian-endpoint/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus

# DashScope API Key (与 QWEN_API_KEY 可共用)
DASHSCOPE_API_KEY=your_dashscope_api_key
# 注意: Settings 没有 dashscope_api_base 字段，此键不会生效。
# DashScope 原生端点已固定在客户端代码中，如需自定义请改 QWEN_API_BASE
# DASHSCOPE_API_BASE=https://your-bailian-endpoint/api/v1

# 商汤科技 SenseNova API Key (LLM、图片生成)
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 可灵AI API Key (视频生成)
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ===== LangSmith 追踪配置 (可选) =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=cbcf-platform

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8002
DEBUG=true

# ===== 存储配置 =====
STORAGE_TYPE=local
STORAGE_PATH=./output

# ===== 日志配置 =====
LOG_LEVEL=INFO

# ===== PostgreSQL 配置 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=cbcf

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== RAG 配置 =====
RAG_ENABLED=true
# local: 本地 BGE-large-zh 模型（无需 API Key，首次使用会自动下载约 1.2GB）
# qwen : 千问 Embedding API（需配置 QWEN_API_KEY / DASHSCOPE_API_KEY）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_DEVICE=cpu
# 也可先运行 scripts/download_embedding_model.py 下载到本地，再启用下面的路径离线加载
# EMBEDDING_MODEL_PATH=models/BAAI/bge-large-zh
# 仅当 EMBEDDING_PROVIDER=qwen 时生效（本地 BGE-large-zh 固定 1024，DB 向量列亦为 Vector(1024)）
QWEN_EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ===== RAG 高级配置 =====
# 注意: Settings 未设置 env_prefix，键名必须与字段名完全一致
# (例如 RERANKER_ENABLED，而不是 RAG_RERANKER_ENABLED，否则该键静默失效)
# Query 改写
QUERY_REWRITING_ENABLED=false
QUERY_REWRITING_MODE=single
QUERY_REWRITING_MAX_VARIANTS=3
HYDE_ENABLED=false

# Cross-Encoder 重排序
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
RERANKER_DEVICE=auto

# 混合检索 (Dense+Sparse+ColBERT)
HYBRID_RETRIEVAL_ENABLED=false
HYBRID_MODEL=BAAI/bge-m3
HYBRID_DENSE_WEIGHT=0.4
HYBRID_SPARSE_WEIGHT=0.3
HYBRID_COLBERT_WEIGHT=0.3
HYBRID_RRF_K=60

# ===== Mock 资产降级 =====
ALLOW_MOCK_ASSETS=true

# ===== 认证配置 =====
AUTH_ENABLED=false
# 凭证加密密钥: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your_fernet_key_here
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
